define user ask something
  "*"

define flow
  user ask something
  execute self_check_input

  if $allowed == false
    bot refuse to respond
    stop

  $answer = execute generate_bot_message

  execute self_check_output

  if $allowed == false
    bot refuse to respond
    stop

  execute self_check_hallucination

  if $allowed == false
    bot inform answer might be wrong
    stop

  bot $answer


define bot refuse to respond
  "해당 요청은 처리할 수 없습니다."


define bot inform answer might be wrong
  "이 응답은 정확하지 않을 수 있습니다. 중요한 사항은 반드시 확인하세요."